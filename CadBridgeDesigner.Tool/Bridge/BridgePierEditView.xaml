             xmlns:local="clr-namespace:CadBridgeDesigner.Tool.Bridge"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=local:BridgeEditViewModel, IsDesignTimeCreatable=True}">
